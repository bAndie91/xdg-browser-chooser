#!/usr/bin/perl
#
# xdg-browser-chooser - http/https scheme handler which does nothing but hand the
# URL over to another installed application, chosen by URL pattern.
#
# Config: $XDG_CONFIG_HOME/xdg-browser-chooser/rules.conf (or any dir of
#         $XDG_CONFIG_DIRS), or the file given with -c.

use strict;
use warnings;

use Cwd qw(abs_path);
use Fcntl qw(O_WRONLY O_CREAT O_EXCL);
use File::Basename qw(dirname);
use File::DesktopEntry;
use File::Find ();
use File::Path qw(make_path);
use File::Spec;
use File::XDG 1.00;
use Getopt::Long qw(:config no_ignore_case bundling);
use URI;

my $APP  = 'xdg-browser-chooser';
my $DEFAULT_CONFIG = <<'DEFAULT_CONFIG';
# Lines starting with '#' are comments.
# Line format: PATTERN whitespace APPLICATION
#
# PATTERN without "/"  -> match to the URI's hostname part
#   - case-insensitive
#   - examples:
#     example.com        exactly that host
#     .example.com       example.com and any subdomain of it, any depth
#     *.example.com      exactly one extra label; NOT example.com itself
#     www*.example.com   '*' inside a label matches within that label only
#     **.example.com     any number of extra labels; NOT example.com itself
#
# PATTERN with "/"     -> Perl regexp match the hostname and path of the URI
#   - no scheme, no query string, no fragment
#   - port is present only if it is not the scheme's default one
#   - percent-encoded
#   - can not contain whitespace - substitute with \s or [[:blank:]]
#
# APPLICATION          -> which Freedesktop application to open URI with
#   1. application ID (i.e. desktop file basename, e.g. "firefox.desktop")
#   2. application Name (e.g. "Firefox")
#      - in the current or in the C locale
#      - supports '*' as a wildcard, case-insensitive
#   3. an absolute file path (starting with "/") takes as a Desktop Entry file
#
# First matching rule wins.
# If nothing matches, the next handler for x-scheme-handler/<scheme> is used.
DEFAULT_CONFIG

my $SELF = abs_path($0) // $0;

my ($opt_dry, $opt_verbose);
GetOptions(
	'n|dry-run'   => \$opt_dry,
	'v|verbose'   => \$opt_verbose,
	'h|help'      => sub { usage(0) },
) or usage(2);
usage(2) unless @ARGV == 1;
my $url = $ARGV[0];

# File::XDG: config_home()/data_home() are suffixed with the application name,
# the *_dirs_list() are not. Only the latter are used as they are.
my $xdg = File::XDG->new(name => $APP, api => 1, path_class => 'File::Spec');

sub verbose { print STDERR "$APP: @_\n" if $opt_verbose }
sub usage {
	my $rc = shift;
	print { $rc ? *STDERR : *STDOUT } "usage: $APP [-n|--dry-run] [-v|--verbose] URL\n";
	exit $rc;
}

###############################################################################
# Config

sub host_pattern_to_regex {
	my $p = lc shift;
	$p =~ s/\.$//;
	my $subdomains = ($p =~ s/^\.//);
	return undef if $p eq '';
	my $body = join '\.', map {
		$_ eq '**' ? '[^.]+(?:\.[^.]+)*'                   # one or more whole labels
		: $_ eq '*' ? '[^.]+'                              # exactly one whole label
		: join('[^.]*', map { quotemeta } split(/\*+/, $_, -1))   # '*' inside a label
	} split /\./, $p, -1;
	$body = '(?:[^.]+\.)*' . $body if $subdomains;
	return qr/^$body$/;
}

sub load_rules {
	my $file = shift;
	open my $fh, '<:encoding(UTF-8)', $file or die "$APP: $file: $!\n";
	my @rules;
	while (my $line = <$fh>) {
		chomp $line;
		$line =~ s/^\s+//;
		$line =~ s/\s+$//;
		next if $line eq '' or $line =~ /^#/;
		my ($pat, $app) = $line =~ /^(\S+)\s+(.+)$/
			or do { warn "$APP: $file:$.: PATTERN and APPLICATION expected\n"; next };
		my ($kind, $re);
		if ($pat =~ m{/}) {
			$kind = 'uri';
			$re = eval { qr/^(?:$pat)$/ };
			if ($@) { warn "$APP: $file:$.: bad regexp: $@"; next }
		}
		else {
			$kind = 'host';
			$re = host_pattern_to_regex($pat)
				or do { warn "$APP: $file:$.: bad host pattern\n"; next };
		}
		push @rules, { kind => $kind, re => $re, pattern => $pat, app => $app, line => $. };
	}
	close $fh;
	return @rules;
}

# First run: write the documented defaults defined near the top of this script.
sub create_config {
	my $path = File::Spec->catfile($xdg->config_home, 'rules.conf');
	my $dir = dirname($path);
	eval { make_path($dir); 1 } or do { warn "$APP: cannot create $dir: $@"; return };
	sysopen(my $out, $path, O_WRONLY | O_CREAT | O_EXCL, 0666)
		or do { warn "$APP: cannot create $path: $!\n"; return };
	binmode $out, ':encoding(UTF-8)';
	print $out $DEFAULT_CONFIG;
	close $out or do { warn "$APP: $path: $!\n"; return };
	warn "$APP: no rules.conf found, created $path\n";
	return $path;
}

sub find_or_create_config {
	my $cfg = $xdg->lookup_config_file('rules.conf');
	return $cfg if defined $cfg;
	if ($opt_dry) {
		verbose('no rules.conf found, not creating one in dry-run mode');
		return;
	}
	return create_config();
}

###############################################################################
# Finding desktop files

sub app_dirs {
	return map { File::Spec->catdir($_, 'applications') }
		dirname($xdg->data_home), $xdg->data_dirs_list;
}

sub find_by_id {
	my $id = shift;
	# "a-b-c.desktop" may also live as a/b-c.desktop, a/b/c.desktop
	my @parts = split /-/, $id;
	my @variants = ($id);
	push @variants, join('/', @parts[0 .. $_ - 1]) . '/' . join('-', @parts[$_ .. $#parts])
		for 1 .. $#parts;
	for my $dir (app_dirs()) {
		for my $v (@variants) {
			my $f = "$dir/$v";
			return $f if -f $f;
		}
	}
	return;
}

my @all_desktop_files;
sub all_desktop_files {
	unless (@all_desktop_files) {
		for my $dir (app_dirs()) {
			next unless -d $dir;
			File::Find::find({
				no_chdir   => 1,
				preprocess => sub { sort @_ },    # same order on every filesystem
				wanted   => sub { push @all_desktop_files, $_ if /\.desktop$/ and -f $_ },
			}, $dir);
		}
	}
	return @all_desktop_files;
}

# PERFORMANCE NOTE: matching an APPLICATION by Name means looking into *every*
# desktop file (typically several hundred). Doing that with File::DesktopEntry->new
# (which parses and regexp-processes each file completely, all the translated
# Name[xx]/Comment[xx] lines included) took ~300 ms for 560 files, versus ~40 ms
# for the whole run when the rule names a .desktop ID. So the scan below only
# extracts the handful of keys it needs, and stops at the first match unless
# --verbose asked for the full list. File::DesktopEntry is still used for the
# one file that is finally chosen (Exec= field-code expansion and exec).

# Read Type, Hidden, Name and Name[xx] of the [Desktop Entry] group; undef if unreadable.
# Escape sequences in values (\s, \n, ...) are not interpreted - irrelevant for names.
sub desktop_header {
	my $file = shift;
	open my $fh, '<:raw', $file or return;
	my (%h, $in_group);
	while (<$fh>) {
		if (/^\[(.*?)\]\s*$/) {
			last if $in_group;                    # next group begins: done
			$in_group = ($1 eq 'Desktop Entry');
			next;
		}
		next unless $in_group;
		next unless /^(Type|Hidden|Name(?:\[[^\]]*\])?)\s*=\s*(.*?)\s*$/;
		my ($k, $v) = ($1, $2);
		utf8::decode($v);       # desktop files are UTF-8; rules are character strings
		$h{$k} = $v;
	}
	return \%h;
}

# Locales whose Name[...] translations count, per the Desktop Entry spec's matching
# order for the current locale (lang_COUNTRY@MODIFIER, lang_COUNTRY, lang@MODIFIER,
# lang), then en_US and en as a courtesy. The untranslated Name is always checked.
my @name_locales;
sub name_locales {
	unless (@name_locales) {
		my $l = $ENV{LC_ALL} || $ENV{LC_MESSAGES} || $ENV{LANG} || '';
		$l =~ s/\..*?(?=@|$)//;                     # drop .encoding
		my ($lang, $country, $mod) = $l =~ /^([^_@]+)(?:_([^@]+))?(?:@(.+))?$/;
		my @chain;
		if (defined $lang and $lang ne 'C' and $lang ne 'POSIX') {
			push @chain, "${lang}_${country}\@$mod" if defined $country and defined $mod;
			push @chain, "${lang}_$country"        if defined $country;
			push @chain, "$lang\@$mod"             if defined $mod;
			push @chain, $lang;
		}
		my %seen;
		@name_locales = grep { !$seen{$_}++ } (@chain, qw(en_US en));
	}
	return @name_locales;
}

# Return true if the untranslated or any relevant translated Name matches.
sub desktop_name_matches {
	my ($h, $re) = @_;
	my $name = $h->{Name};
	return 1 if defined $name and $name =~ $re;
	for my $loc (name_locales()) {
		my $translated = $h->{"Name[$loc]"};
		return 1 if defined $translated and $translated =~ $re;
	}
	return 0;
}

# Desktop files of the applications whose Name matches $re, in lookup order.
# $limit > 0: stop after that many.
sub find_by_name {
	my ($re, $skip_self, $limit) = @_;
	my @found;
	for my $f (all_desktop_files()) {
		my $h = desktop_header($f) or next;
		next unless ($h->{Type} // '') eq 'Application';
		next if ($h->{Hidden} // '') eq 'true';
		next unless desktop_name_matches($h, $re);
		next if $skip_self and is_self(File::DesktopEntry->new($f));
		push @found, $f;
		last if $limit and @found >= $limit;
	}
	return @found;
}

# APPLICATION of a rule -> ($has_wildcard, case-insensitive whole-name regexp, literal).
# An unescaped '*' is a wildcard; '\*' is a literal star, '\\' a literal backslash.
sub app_glob {
	my $app = shift;
	my ($re, $lit, $wild) = ('', '', 0);
	while ($app =~ /\G(?:\\(.)|(\*)|(.))/gcs) {
		if (defined $2) { $re .= '.*'; $wild = 1 }
		else {
			my $c = defined $1 ? $1 : $3;
			$re .= quotemeta $c;
			$lit .= $c;
		}
	}
	return ($wild, qr/^$re$/i, $lit);
}

# APPLICATION field of a rule -> path of a desktop file, or (undef, reason)
sub resolve_app {
	my $app = shift;
	if ($app =~ m{^/}) {
		return $app if -f $app;
		return (undef, "no such file: $app");
	}

	# A .desktop basename is an ID, never a Name. In particular, don't strip
	# the suffix and then accidentally resolve a different application by Name.
	if ($app =~ /\.desktop$/) {
		my $f = find_by_id($app);
		return $f if defined $f;
		return (undef, "desktop file ID not found: $app");
	}

	# Everything else is a Name, even if it contains slashes or resembles a
	# path. '*' retains its documented case-insensitive wildcard meaning.
	my ($wild, $re) = app_glob($app);
	# Only the first match is used. Without --verbose stop scanning there.
	my @found = find_by_name($re, 1, $opt_verbose ? 0 : 1);
	return (undef, "no application name matches: $app") unless @found;
	verbose("application $app matches " . scalar(@found) . " desktop file(s): "
		. join(', ', @found) . "; using the first");
	return $found[0];
}

# Does this desktop entry start us? (guards against infinite loops)
sub is_self {
	my $de = shift;
	my $exec = $de->get('Exec');
	return 0 unless defined $exec;
	$exec =~ /^\s*(?:"((?:[^""\\]|\\.)+)"|(\S+))/ or return 0;
	my $cmd = $1 // $2;
	unless ($cmd =~ m{/}) {
		my ($found) = grep { -x "$_/$cmd" and !-d "$_/$cmd" } split /:/, ($ENV{PATH} // '');
		return 0 unless defined $found;
		$cmd = "$found/$cmd";
	}
	return (abs_path($cmd) // '') eq $SELF ? 1 : 0;
}

###############################################################################
# Fallback: the default handler for x-scheme-handler/<scheme>
#
# Standard: "Association between MIME types and applications" (mime-apps-spec,
# version 1.0.1), https://specifications.freedesktop.org/mime-apps/latest/
#
# Is more than one default application allowed per MIME type?
#   Yes. The value of a key in the [Default Applications] group is a
#   semicolon-separated *list* of desktop file IDs. The first one that is
#   installed (and associated with the type) is the default; if it is gone,
#   the next one is tried, and so on. We do the same, which is what makes
#       x-scheme-handler/http=xdg-browser-chooser.desktop;firefox.desktop;
#   work: we are the first entry, so firefox is "the default minus us".
#
# Which mimeapps.list is what? The spec's lookup order, highest precedence first:
#   $XDG_CONFIG_HOME/$desktop-mimeapps.list   (~/.config)  user, desktop-specific
#   $XDG_CONFIG_HOME/mimeapps.list            (~/.config)  user settings; the
#                                             recommended place, written by
#                                             "xdg-mime default" and settings GUIs
#   $XDG_CONFIG_DIRS/...                      (/etc/xdg)   sysadmin / vendor overrides
#   $XDG_DATA_HOME/applications/...    (~/.local/share/applications)
#                                             the *old* location of the user's file,
#                                             kept only "for compatibility,
#                                             deprecated": same format and syntax,
#                                             but ranks below the config dirs; some
#                                             older programs still read/write it
#   $XDG_DATA_DIRS/applications/...    (/usr/share/applications)
#                                             distribution defaults
#   In each directory "$desktop-mimeapps.list" (one per component of
#   $XDG_CURRENT_DESKTOP, lowercased) is looked at before "mimeapps.list".
#   Desktop-specific files may only contain [Default Applications]; the Added /
#   Removed groups are valid only in the plain mimeapps.list, so we ignore
#   them in $desktop-mimeapps.list.
#
# And defaults.list? It is not part of the spec at all (1.0.1 does not mention it).
#   It is the predecessor of mimeapps.list: $XDG_DATA_DIRS/applications/defaults.list
#   (and the same under $XDG_DATA_HOME/applications, e.g.
#   ~/.local/share/applications/defaults.list), carrying only a [Default Applications]
#   group. GLib deprecated it in 2014 in favour of mimeapps.list in the data
#   directories, but old tools and old setups still have or read it. As it has no
#   defined precedence, we use it as the lowest-priority source of
#   *default* applications: consulted only after every mimeapps.list had its say.
#
# mimeinfo.cache (written by update-desktop-database, one per applications
#   directory) is a precomputed index of the MimeType= lines of the desktop files
#   there: MIME type -> IDs of the applications declaring it. It knows nothing of
#   user choices; it answers "who *can* open this", not "who *should*". It can be
#   stale (installing/removing a package without running update-desktop-database),
#   so it ranks last, and every candidate is re-checked against the real file.
#
# Candidates, best first:
#   1. "Default Applications" of all mimeapps.list files, in precedence order
#      (list order = priority within a key), then of the legacy defaults.list
#   2. "Added Associations" of the mimeapps.list files
#   3. mimeinfo.cache
# Whatever starts this very script, is hidden or is removed is skipped.
#
# Known simplifications relative to the spec's suggested algorithm:
#   - A default is not verified to be "associated with the type" (i.e. listing
#     the MIME type in MimeType= or in Added Associations). Whoever put it in
#     [Default Applications] explicitly wanted it, so we take it as is.
#   - "Removed Associations" is applied to every candidate, not only to desktop
#     files in the same or a lower-precedence directory as the mimeapps.list that
#     removes them.
#   - No MIME type hierarchy (the spec repeats the process from the most specific
#     to the least specific type); x-scheme-handler/* types have no parents.

sub keyfile_lists {
	my ($file, $key) = @_;
	my (%out, $section);
	open my $fh, '<:encoding(UTF-8)', $file or return {};
	while (<$fh>) {
		chomp;
		if (/^\s*\[(.+)\]\s*$/) { $section = $1; next }
		next unless defined $section and /^\s*\Q$key\E\s*=\s*(.*?)\s*$/;
		push @{ $out{$section} }, grep { length } split /;/, $1;
	}
	return \%out;
}

# The mimeapps.list files that exist, highest precedence first, as
# [ path, is_desktop_specific ] pairs. See the comment above for the order.
sub mimeapps_files {
	my @desktops = map { lc } grep { length } split /:/, ($ENV{XDG_CURRENT_DESKTOP} // '');
	my @dirs = (
		dirname($xdg->config_home), $xdg->config_dirs_list,
		app_dirs(),
	);
	my @out;
	for my $d (@dirs) {
		for my $desktop (@desktops) {
			my $f = "$d/$desktop-mimeapps.list";
			push @out, [$f, 1] if -f $f;
		}
		my $f = "$d/mimeapps.list";
		push @out, [$f, 0] if -f $f;
	}
	return @out;
}

# Legacy (pre-mimeapps.list) default applications, see the comment above.
sub legacy_defaults_files {
	return grep { -f } map { "$_/defaults.list" } app_dirs();
}

sub fallback_file {
	my $mime = shift;
	# Candidates are [ desktop file ID, where it was listed ]
	my (@defaults, @added, %removed, @cached);
	my @lists = mimeapps_files();
	my @legacy = legacy_defaults_files();
	verbose("fallback: mimeapps.list files: " . (@lists ? join(' ', map { $_->[0] } @lists) : '(none)'));
	verbose("fallback: legacy defaults.list files: " . (@legacy ? join(' ', @legacy) : '(none)'));
	verbose("fallback: application dirs: " . join(' ', app_dirs()));
	for my $e (@lists) {
		my ($f, $desktop_specific) = @$e;
		my $l = keyfile_lists($f, $mime);
		push @defaults, map { [$_, "Default Applications in $f"] } @{ $l->{'Default Applications'} // [] };
		next if $desktop_specific;    # Added/Removed Associations are not valid there
		push @added,    map { [$_, "Added Associations in $f"] } @{ $l->{'Added Associations'} // [] };
		$removed{$_} //= $f for @{ $l->{'Removed Associations'} // [] };
	}
	for my $f (@legacy) {
		my $l = keyfile_lists($f, $mime);
		push @defaults, map { [$_, "Default Applications in legacy $f"] } @{ $l->{'Default Applications'} // [] };
	}
	for my $dir (app_dirs()) {
		my $f = "$dir/mimeinfo.cache";
		push @cached, map { [$_, "MIME Cache in $f"] } @{ keyfile_lists($f, $mime)->{'MIME Cache'} // [] } if -f $f;
	}
	my @candidates = (@defaults, @added, @cached);
	verbose("fallback: " . scalar(@candidates) . " candidate(s) for $mime, best first");
	my %seen;
	for my $c (@candidates) {
		my ($id, $src) = @$c;
		my $skip = sub { verbose("fallback: $id ($src): skipped, $_[0]") };
		$skip->("listed in Removed Associations in $removed{$id}"), next if $removed{$id};
		$skip->('already considered'), next if $seen{$id}++;
		my $f = find_by_id($id) or $skip->('no such desktop file'), next;
		my $de = File::DesktopEntry->new($f);
		$skip->("$f is not an Application"), next unless ($de->get('Type') // '') eq 'Application';
		$skip->("$f is Hidden"), next if ($de->get('Hidden') // '') eq 'true';
		$skip->("$f would start $APP itself"), next if is_self($de);
		verbose("fallback: $id ($src): selected, $f");
		return $f;
	}
	verbose("fallback: no usable handler for $mime among " . scalar(@candidates) . " candidate(s)");
	return;
}

###############################################################################

# URI does the parsing; canonical() lowercases scheme and host, drops the default port.
my $uri    = URI->new($url)->canonical;
my $scheme = lc($uri->scheme // '');

# Rules apply to http(s) URLs only. $host is what host patterns are matched
# against, $target ("HOST[:PORT]/PATH", see the top comment) is for regexps.
my ($host, $target);
if ($scheme eq 'http' or $scheme eq 'https') {
	my $h = eval { $uri->host };
	if (defined $h and length $h) {
		($host = lc $h) =~ s/\.$//;                          # FQDN root dot
		my $hostport = $host =~ /:/ ? "[$host]" : $host;     # IPv6 literal
		my $port = $uri->port;
		$hostport .= ":$port" if defined $port and $port != $uri->default_port;
		my $path = $uri->path;
		$path = '/' unless length $path;
		$target = $hostport . $path;
	}
}
my $file;
my $why;    # why the rules did not decide; logged when we fall back

if (!defined $host) {
	$why = 'the URL has no http(s) host for rules to match';
}
elsif (!defined(my $cfg = find_or_create_config())) {
	$why = 'no rules.conf found';
}
else {
	my @rules = load_rules($cfg);
	verbose("config: $cfg, " . scalar(@rules) . " rule(s)");
	verbose("matching host '$host', target '$target'");
	my $matched = 0;
	for my $rule (@rules) {
		next unless ($rule->{kind} eq 'host' ? $host : $target) =~ $rule->{re};
		$matched++;
		verbose("rule at line $rule->{line} matched: $rule->{pattern} -> $rule->{app}");
		my ($f, $err) = resolve_app($rule->{app});
		# A matching rule that cannot be carried out is a configuration error:
		# say so instead of quietly opening some other application.
		unless (defined $f) {
			warn "$APP: $cfg:$rule->{line}: $err\n";
			exit 1;
		}
		if (is_self(File::DesktopEntry->new($f))) {
			warn "$APP: $f would start $APP itself, skipping rule at line $rule->{line}\n";
			next;
		}
		$file = $f;
		last;
	}
	$why = $matched ? "$matched rule(s) matched but none was usable" : 'no rule matched'
		unless defined $file;
}

unless (defined $file) {
	verbose("falling back to the next x-scheme-handler/$scheme handler: $why");
	$file = fallback_file("x-scheme-handler/$scheme")
		// die "$APP: no handler found for x-scheme-handler/$scheme\n";
}

my $entry = File::DesktopEntry->new($file);
verbose("using $file");

if ($opt_dry) {
	print "$file\n", join(' ', $entry->parse_Exec($url)), "\n";
	exit 0;
}

$entry->exec($url);
die "$APP: cannot execute $file: $!\n";
